# =========================================================
# HYDROLINK PLUMBING - OPTIMIZED .HTACCESS
# =========================================================

# ---------------------------------------------------------
# CUSTOM 404 PAGE (outside any IfModule so it always applies).
# Apache keeps the 404 status because the path is local; do not change
# it to a full http(s):// URL or Apache will send a 302 redirect instead.
# ---------------------------------------------------------
ErrorDocument 404 /error.html

# Private file types (outside IfModule rewrite so they always apply)
<FilesMatch "(^.ht|.(bak|zip|log|md|csv|sql|tar|gz)$|^(secrets.php|secrets.example.php|crawl.json|vercel.json|error_log|composer.(json|lock)|backup_index.html)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------
# PRIVATE FILES (added in final QA): never serve secrets, backups, archives,
# reports or version-control data if they are uploaded by mistake.
# ---------------------------------------------------------
RewriteRule ^(?:_audit|include|mail|.git|.claude|cgi-bin)(?:/|$) - [R=404,L]

# ---------------------------------------------------------
# 1. REMOVE WWW (and force HTTPS in the same single redirect)
# Preferred URL: https://hydrolinkplumbing.com.au/
# Canonicalisation update 2026-11-26: www and http now reach the
# preferred URL in one 301 instead of two. Same rules as before,
# reordered. Query strings are kept automatically.
# ---------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ---------------------------------------------------------
# 2. HTTPS REDIRECT
# The X-Forwarded-Proto check stops a redirect loop if a proxy or CDN
# (for example Cloudflare "Flexible" SSL) talks to this server over HTTP.
# ---------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# ---------------------------------------------------------
# 2b. CANONICAL URL CLEANUP 2026-11-26
# Each page has one final URL: the .html file, and / for the home page.
# ---------------------------------------------------------
# /index.html and /index.php -> /
RewriteCond %{THE_REQUEST} \s/index\.(?:html|php)[\s?] [NC]
RewriteRule ^index\.(?:html|php)$ https://%{HTTP_HOST}/ [R=301,L]

# Article .php URLs -> the same .html page (only when a non-empty .html copy exists).
# Form handlers, thankyou.php, index.php and three pages without a usable .html copy are excluded.
RewriteCond %{DOCUMENT_ROOT}/$1.html -s
RewriteRule ^(?!(?:index|thankyou|1send_mail|appointment-from|con-slider-form|slider-form|minify|secrets|secrets\.example|common-places-you-might-find-asbestos-in-your-home)\.php$)([^/]+)\.php$ https://%{HTTP_HOST}/$1.html [R=301,L]

# Extension-less URLs (for example /emergency) -> /emergency.html when that file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -s
RewriteRule ^([A-Za-z0-9_-]+)/?$ https://%{HTTP_HOST}/$1.html [R=301,L]

# ---------------------------------------------------------
# SUBURB CLEANUP 2026-11-26: retired suburb pages -> /areas.html (301)
# 334 rules. Archive: hydrolink-archive-suburbs-20261126
# ---------------------------------------------------------
